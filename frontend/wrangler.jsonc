{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moing-moing",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-24",
  "keep_vars": true,
  "vars": {
    "API_ORIGIN": "https://moing-moing-api.onrender.com",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
  },
}
