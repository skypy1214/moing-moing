# Docker Compose development database. Copy this file to .env if values need to change.
POSTGRES_DB=moing_moing
POSTGRES_USER=moing_moing
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432

# Backend datasource. The defaults match the Compose service when the backend runs on the host.
DB_URL=jdbc:postgresql://localhost:5432/moing_moing
DB_USERNAME=moing_moing
DB_PASSWORD=local_dev_only

# Development frontend origin. Render production uses CORS_ALLOWED_ORIGINS from its secret settings.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Base64-encoded 32-byte AES key used to show an already-issued coupon QR code again.
QR_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Required only when the first local administrator account is created.
# Never commit the real password.
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PASSWORD=change-this-before-use
